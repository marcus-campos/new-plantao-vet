# URL da API. Em dev, o backend sobe em 8000 (ou outra porta livre).
VITE_API_URL=http://localhost:8000

# Push no navegador (o mesmo projeto Firebase do app e do backend).
# VITE_FIREBASE_CONFIG é o objeto "firebaseConfig" do console do Firebase, em
# UMA linha de JSON. VITE_FIREBASE_VAPID_KEY é a "Web Push certificate" (par
# de chaves) em Cloud Messaging. Vazios = o botão de alertas não aparece.
VITE_FIREBASE_CONFIG=
VITE_FIREBASE_VAPID_KEY=
